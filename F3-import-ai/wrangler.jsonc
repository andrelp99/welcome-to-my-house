{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "welcome-to-my-house",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "welcome-house-db",
      "database_id": "d29fd7aa-3a1d-417b-afc0-6dd91c984f26",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "AI_MODEL": "@cf/qwen/qwen3.8-27b",
    "AI_MODEL_FALLBACK": "@cf/mistralai/mistral-small-3.1-24b-instruct"
  },
  "observability": {
    "enabled": true
  }
}
