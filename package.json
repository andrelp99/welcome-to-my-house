{
  "name": "welcome-to-my-house",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev",
    "build": "vite build",
    "preview": "vite build && wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply welcome-house-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply welcome-house-db --remote",
    "typecheck": "tsc --noEmit -p tsconfig.worker.json"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "hono": "^4.13.9",
    "lucide-react": "^0.500.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260925.2",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.141.0"
  }
}
